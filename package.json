{
  "name": "@facile/facteur",
  "version": "0.2.0",
  "description": "Transactional mailer for the Facile Suite — SMTP transport, suite-wide env convention, in-memory test seam",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "export:templates": "bun run scripts/export-templates.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "nodemailer": "^6.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FacileStudio/facteur.git",
    "directory": "ts"
  },
  "license": "MIT"
}
